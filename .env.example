# Your public site address (no trailing slash). Set at BUILD time.
VITE_SITE_URL=https://www.your-domain.com
# Same value, used at runtime for robots.txt and sitemap.xml.
SITE_URL=https://www.your-domain.com
# From Google Search Console > Settings > Ownership verification > HTML tag (content value only).
# VITE_GOOGLE_SITE_VERIFICATION=
# Rate limiting (optional)
# RATE_LIMIT_PAGE_MAX=120
# RATE_LIMIT_API_MAX=20
# RATE_LIMIT_WINDOW_MS=60000
# TRUSTED_PROXY_HOPS=1
